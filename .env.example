# Environment for `docker compose up`. Copy to .env and fill in.
# The API's own settings live in api/.env (see api/.env.example); these two are
# the ones compose passes into the container.

# Signs session tokens. At least 32 characters, and keep it — changing it signs
# everyone out. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SYNAPSE_JWT_SECRET=

# Optional. Without it the /cortex/* endpoints return 503 and the studio falls
# back to its built-in rules engine. https://console.anthropic.com
ANTHROPIC_API_KEY=
