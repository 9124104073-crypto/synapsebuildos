{
  "version": 2,
  "buildCommand": "cd app && npm install && npm run build",
  "outputDirectory": "app/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/legacy/(.*)",
      "destination": "/legacy/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
