{
  "version": 2,
  "buildCommand": "cd app && npm install && npm run build",
  "outputDirectory": "app/dist",
  "rewrites": [
    { "source": "/auth", "destination": "/api/index.py" },
    { "source": "/auth/:path*", "destination": "/api/index.py" },
    { "source": "/projects", "destination": "/api/index.py" },
    { "source": "/projects/:path*", "destination": "/api/index.py" },
    { "source": "/plans", "destination": "/api/index.py" },
    { "source": "/plans/:path*", "destination": "/api/index.py" },
    { "source": "/reference", "destination": "/api/index.py" },
    { "source": "/reference/:path*", "destination": "/api/index.py" },
    { "source": "/cortex", "destination": "/api/index.py" },
    { "source": "/cortex/:path*", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/api", "destination": "/api/index.py" },
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/legacy/:path*", "destination": "/legacy/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
