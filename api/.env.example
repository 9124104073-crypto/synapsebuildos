# Copy to api/.env and fill in. api/.env is git-ignored — never commit a key.

# Claude — powers prompt-to-layout editing, layout generation, structural notes
# and the lived-experience simulation. Get one at https://console.anthropic.com
# (Settings → API keys). Without it those endpoints return 503 and the studio
# falls back to its built-in rules engine.
ANTHROPIC_API_KEY=

# Signs the session tokens. At least 32 characters. Set it, or everyone is
# signed out whenever the API restarts. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SYNAPSE_JWT_SECRET=

# Optional overrides
# SYNAPSE_MODEL=claude-opus-5
# SYNAPSE_DATABASE_URL=postgresql+psycopg://user:pass@localhost/synapse
# SYNAPSE_CORS_ORIGINS=http://127.0.0.1:5173
