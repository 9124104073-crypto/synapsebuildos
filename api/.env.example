# Copy to api/.env and fill in. api/.env is git-ignored — never commit a key.
# Without any key the /cortex/* endpoints return 503 and the studio falls back
# to its built-in rules engine; everything else works.

# ---------------------------------------------------------------------------
# Option A — a FREE key (no card). Pick one, paste the key, done.
# ---------------------------------------------------------------------------
# Google AI Studio (Gemini) — https://aistudio.google.com/apikey
# SYNAPSE_LLM_PROVIDER=openai
# SYNAPSE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# SYNAPSE_LLM_MODEL=gemini-2.5-flash
# SYNAPSE_LLM_API_KEY=
#
# Groq (fastest) — https://console.groq.com/keys
# SYNAPSE_LLM_PROVIDER=openai
# SYNAPSE_LLM_BASE_URL=https://api.groq.com/openai/v1
# SYNAPSE_LLM_MODEL=llama-3.3-70b-versatile
# SYNAPSE_LLM_API_KEY=
#
# OpenRouter (many models) — https://openrouter.ai/keys
# SYNAPSE_LLM_PROVIDER=openai
# SYNAPSE_LLM_BASE_URL=https://openrouter.ai/api/v1
# SYNAPSE_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# SYNAPSE_LLM_API_KEY=
#
# Ollama on your own machine (no key, no internet) — https://ollama.com
# SYNAPSE_LLM_PROVIDER=openai
# SYNAPSE_LLM_BASE_URL=http://127.0.0.1:11434/v1
# SYNAPSE_LLM_MODEL=llama3.1:8b
# SYNAPSE_LLM_API_KEY=ollama
#
# Free tiers usually train on what you send. Keep client data off them.

# ---------------------------------------------------------------------------
# Option B — Claude (paid; new accounts get a one-time $5 trial credit).
# https://console.anthropic.com → Settings → API keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Signs the session tokens. At least 32 characters. Set it, or everyone is
# signed out whenever the API restarts. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SYNAPSE_JWT_SECRET=

# Optional overrides
# SYNAPSE_MODEL=claude-opus-5
# SYNAPSE_DATABASE_URL=postgresql+psycopg://user:pass@localhost/synapse
# SYNAPSE_REDIS_URL=redis://127.0.0.1:6379/0
# SYNAPSE_CORS_ORIGINS=http://127.0.0.1:5173
